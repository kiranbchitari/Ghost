{
  "expo": {
    "name": "Snake",
    "slug": "ghost",
    "version": "1.0.0",
    "scheme": "ghost",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kiran.ghost"
    },
    "android": {
      "package": "com.kiran.ghost",
      "adaptiveIcon": {
        "backgroundColor": "#c7d9a3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ghost needs your photos so you can share them in encrypted chats.",
          "cameraPermission": "Ghost needs the camera so you can take photos to share in encrypted chats. Photos are never saved to your gallery.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ghost needs the camera so you can take photos to share in encrypted chats. Photos are never saved to your gallery.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
